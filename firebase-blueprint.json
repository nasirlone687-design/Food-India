  "firestore": {
    "/users/{userId}": { "schema": "User", "description": "Core identity for all users." },
    "/customers/{userId}": { "schema": "Customer", "description": "Customer specific data." },
    "/sellers/{sellerId}": { "schema": "Seller", "description": "Seller specific data." },
    "/restaurants/{restaurantId}": { "schema": "Restaurant", "description": "Restaurant details." },
    "/categories/{categoryId}": { "schema": "Category", "description": "Food categories." },
    "/products/{productId}": { "schema": "Product", "description": "Food products/menu items." },
    "/addresses/{addressId}": { "schema": "Address", "description": "User saved addresses." },
    "/carts/{cartId}": { "schema": "Cart", "description": "Active shopping carts." },
    "/orders/{orderId}": { "schema": "Order", "description": "Order records." },
    "/deliveryProviders/{providerId}": { "schema": "DeliveryProvider", "description": "Delivery provider integrations." },
    "/deliveryServiceAreas/{areaId}": { "schema": "DeliveryServiceArea", "description": "State, city, district, and GPS service areas for delivery providers." },
    "/deliveryQuotes/{quoteId}": { "schema": "DeliveryQuote", "description": "Generated delivery quotes." },
    "/deliveryBookings/{bookingId}": { "schema": "DeliveryBooking", "description": "Confirmed delivery bookings." },
    "/deliveryStatusHistory/{historyId}": { "schema": "DeliveryStatusHistory", "description": "Delivery booking status history." },
    "/deliveryWebhookEvents/{eventId}": { "schema": "DeliveryWebhookEvent", "description": "Verified delivery webhook events." },
    "/subscriptionPlans/{planId}": { "schema": "SubscriptionPlan", "description": "Seller subscription plans." },
    "/sellerSubscriptions/{subscriptionId}": { "schema": "SellerSubscription", "description": "Seller active subscriptions." },
    "/payments/{paymentId}": { "schema": "Payment", "description": "Payment records." },
    "/sellerDocuments/{documentId}": { "schema": "SellerDocument", "description": "Seller verification documents." },
    "/reviews/{reviewId}": { "schema": "Review", "description": "Order reviews." },
    "/notifications/{notificationId}": { "schema": "Notification", "description": "User notifications." },
    "/adminSettings/{settingId}": { "schema": "AdminSettings", "description": "Global admin settings." },
    "/auditLogs/{logId}": { "schema": "AuditLog", "description": "System audit logs." }
  }
}
