# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Client-side Maps, Places, Routes)
VITE_GOOGLE_MAPS_API_KEY=""

# Razorpay Credentials (Server-side only — NEVER prefix with VITE_)
# Used exclusively for Seller Subscription Payment Links & Webhook Signature Verification
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Third-Party Delivery Provider Credentials (Server-side only — NEVER prefix with VITE_)
# Sandbox/Test Provider Webhook Secret (used for verifying signed test delivery webhooks)
DELIVERY_SANDBOX_WEBHOOK_SECRET=""

# Porter Enterprise API (India Intercity & Intra-city Hyperlocal Logistics)
PORTER_API_KEY=""
PORTER_WEBHOOK_SECRET=""
PORTER_ENV="sandbox"

# Shadowfax Hyperlocal Flash API
SHADOWFAX_API_TOKEN=""
SHADOWFAX_WEBHOOK_SECRET=""
SHADOWFAX_ENV="sandbox"

# Shiprocket Hyperlocal / SARAL API
SHIPROCKET_API_TOKEN=""
SHIPROCKET_WEBHOOK_SECRET=""

# Dunzo B2B Partner API
DUNZO_CLIENT_ID=""
DUNZO_CLIENT_SECRET=""
DUNZO_WEBHOOK_SECRET=""
