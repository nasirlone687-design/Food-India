rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.email == 'nnasir.lone1@gmail.com' ||
        request.auth.token.email == 'lonen5408@gmail.com'
      );
    }
    function isSeller() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller'
      );
    }
    function isVerifiedSeller() {
      let sellerData = get(/databases/$(database)/documents/sellers/$(request.auth.uid)).data;
      let hasRestaurant = sellerData.restaurantId != null;
      let restaurantApproved = hasRestaurant && get(/databases/$(database)/documents/restaurants/$(sellerData.restaurantId)).data.approvalStatus == 'approved';
      return isSeller() && sellerData.verificationStatus == 'verified' && sellerData.subscriptionStatus == 'active' && restaurantApproved;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collections ---

    // 0. Connection Test Probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // 1. Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // 2. Customers
    match /customers/{userId} {
      allow read, write: if true;
    }

    // 3. Sellers
    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    // 4. Restaurants
    match /restaurants/{restaurantId} {
      allow read, write: if true;
    }

    // 5. Categories
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // 6. Products
    match /products/{productId} {
      allow read, write: if true;
    }

    // 7. Addresses
    match /addresses/{addressId} {
      allow read, write: if true;
    }

    // 8. Carts
    match /carts/{cartId} {
      allow read, write: if true;
    }

    // 9. Orders (supports customer orders, seller live kitchen feed, server-side delivery booking & webhook updates)
    match /orders/{orderId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() || request.auth == null;
      allow update: if isSignedIn() || isAdmin() || request.auth == null;
      allow delete: if isAdmin();
    }

    // 10. Delivery Providers (publicly readable for discovery; admin or initial server seed can write; never contains secrets)
    match /deliveryProviders/{providerId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin() || !exists(/databases/$(database)/documents/deliveryProviders/$(providerId)) || request.auth == null;
      allow update: if isSignedIn() || isAdmin() || request.auth == null;
      allow delete: if isAdmin() || isSignedIn();
    }

    // 11. Delivery Service Areas (configurable by state, city, district, PIN code, and GPS radius)
    match /deliveryServiceAreas/{areaId} {
      allow read: if true;
      allow create: if isSignedIn() || isAdmin() || !exists(/databases/$(database)/documents/deliveryServiceAreas/$(areaId)) || request.auth == null;
      allow update, delete: if isSignedIn() || isAdmin() || request.auth == null;
    }

    // 12. Delivery Quotes (generated by backend during checkout discovery)
    match /deliveryQuotes/{quoteId} {
      allow read: if true;
      allow create, update: if request.auth == null || isSignedIn();
      allow delete: if isAdmin();
    }

    // 13. Delivery Bookings (created after restaurant accepts order; idempotency enforced)
    match /deliveryBookings/{bookingId} {
      allow get: if true;
      allow list: if true;
      allow create: if request.auth == null || isSignedIn();
      allow update: if request.auth == null || isSignedIn() || isAdmin();
      allow delete: if isAdmin();
    }

    // 14. Delivery Status History
    match /deliveryStatusHistory/{historyId} {
      allow read: if true;
      allow create: if request.auth == null || isSignedIn();
      allow update, delete: if isAdmin();
    }

    // 15. Delivery Webhook Events (server & admin audit trail)
    match /deliveryWebhookEvents/{eventId} {
      allow read, write: if true;
    }

    // 16. Subscription Plans
    match /subscriptionPlans/{planId} {
      allow read, write: if true;
    }

    // 17. Seller Subscriptions
    match /sellerSubscriptions/{subscriptionId} {
      allow read, write: if true;
    }

    // 18. Payments
    match /payments/{paymentId} {
      allow read, write: if true;
    }

    // 19. Seller Documents & Binary Chunks
    match /sellerDocuments/{documentId} {
      allow read, write: if true;
    }

    match /sellerDocumentChunks/{chunkId} {
      allow read, write: if true;
    }

    // 20. Reviews
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // 21. Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 22. Admin Settings
    match /adminSettings/{settingId} {
      allow read, write: if true;
    }

    // 23. Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    // 24. App-Wide Error & Button Status Logs (Visible in Admin Section)
    match /appErrorLogs/{logId} {
      allow read: if isSignedIn() || isAdmin() || request.auth == null;
      allow create, update: if true;
      allow delete: if isSignedIn() || isAdmin();
    }

    // 25. Compulsory Startup & Live Device GPS Locations (Saved in Firestore on App/Web Open)
    match /deviceLocations/{deviceId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // 26. Permanent Order Archives
    match /orderArchives/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
