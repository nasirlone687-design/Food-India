rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        (request.auth.token.email == 'lonen5408@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    // Private seller verification documents: only the owning seller or an admin can read/write
    match /sellerDocuments/{sellerUid}/{allPaths=**} {
      allow read: if isSignedIn() && (request.auth.uid == sellerUid || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == sellerUid || isAdmin())
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // Public restaurant logos, covers, and product images (up to 5 images per product)
    match /restaurants/{restaurantId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size < 5 * 1024 * 1024;
    }

    match /products/{restaurantId}/{allPaths=**} {
      allow read: if true;
      allow write: if isSignedIn() && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
